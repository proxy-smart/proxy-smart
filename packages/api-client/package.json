{
  "name": "@proxy-smart/api-client",
  "version": "0.4.13-beta.202609091042.c791a0ca4",
  "private": false,
  "type": "module",
  "description": "Typed fetch client for the Proxy Smart admin and FHIR API, generated from its OpenAPI spec.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/proxy-smart/proxy-smart.git",
    "directory": "packages/api-client"
  },
  "license": "AGPL-3.0-or-later OR LicenseRef-Commercial",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/generated/models/index.d.ts",
      "import": "./dist/generated/models/index.js"
    },
    "./apis": {
      "types": "./dist/generated/apis/index.d.ts",
      "import": "./dist/generated/apis/index.js"
    },
    "./runtime": {
      "types": "./dist/generated/runtime.d.ts",
      "import": "./dist/generated/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-ts-fetch ../../backend/dist/openapi.json ./src/generated",
    "build": "bun run generate && bun run build:bundle && bun run build:types",
    "typecheck": "tsc --noEmit",
    "build:bundle": "bun build src/index.ts src/generated/models/index.ts src/generated/apis/index.ts src/generated/runtime.ts --outdir dist --target browser --format esm --splitting",
    "build:types": "tsc --emitDeclarationOnly"
  },
  "keywords": [
    "proxy-smart",
    "openapi",
    "client",
    "fhir",
    "smart-on-fhir"
  ]
}
