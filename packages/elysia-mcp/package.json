{
  "name": "@proxy-smart/elysia-mcp",
  "version": "0.4.2",
  "versionPolicy": "independent",
  "private": false,
  "type": "module",
  "description": "Auto-generate MCP tools and resources from Elysia routes via introspection. TypeBox-to-Standard-Schema bridge and tool execution; the HTTP edge lives in @maxhealth.tech/mcp-http.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/proxy-smart/proxy-smart.git",
    "directory": "packages/elysia-mcp"
  },
  "license": "AGPL-3.0-or-later OR LicenseRef-Commercial",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prefab": "./src/prefab-view.ts",
    "./introspect": "./src/introspect.ts",
    "./typebox-schema": "./src/typebox-schema.ts",
    "./text-format": "./src/text-format.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1"
  },
  "peerDependencies": {
    "@maxhealth.tech/prefab": ">=0.3.13",
    "@modelcontextprotocol/server": ">=2.0.0",
    "@sinclair/typebox": ">=0.34.0",
    "elysia": ">=1.2.0"
  },
  "peerDependenciesMeta": {
    "@maxhealth.tech/prefab": {
      "optional": true
    }
  },
  "devDependencies": {
    "@maxhealth.tech/prefab": "^0.3.13",
    "@modelcontextprotocol/server": "^2.2.0",
    "@sinclair/typebox": "^0.34.52",
    "elysia": "^1.4.30",
    "typescript": "6.0.3"
  },
  "keywords": [
    "elysia",
    "mcp",
    "model-context-protocol",
    "bun",
    "typebox",
    "introspection",
    "auto-generate",
    "tools",
    "ai"
  ]
}
