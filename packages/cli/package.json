{
  "name": "@proxy-smart/cli",
  "version": "0.4.13-beta.202609091042.c791a0ca4",
  "private": false,
  "type": "module",
  "description": "Admin CLI for the proxy-smart SMART on FHIR authorization proxy. Authenticates via Keycloak OAuth (device flow or client_credentials) and drives the admin REST API.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/proxy-smart/proxy-smart.git",
    "directory": "packages/cli"
  },
  "license": "AGPL-3.0-or-later OR LicenseRef-Commercial",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "proxy-smart": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-ts-fetch ../../backend/dist/openapi.json ./src/api-client --tags smart-apps,healthcare-users,scope-sets,mcp-management,admin,identity-providers,user-federation,roles",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "bun-types": "^1.4.0",
    "typescript": "6.0.3"
  },
  "keywords": [
    "proxy-smart",
    "cli",
    "smart-on-fhir",
    "keycloak",
    "oauth2",
    "device-flow",
    "admin",
    "bun"
  ]
}
