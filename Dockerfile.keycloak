FROM quay.io/keycloak/keycloak:26.8.1

# BASE IMAGE — carries the product (theme, feature flags, optimized build) and
# deliberately NO realm.
#
# The realm is layered on top per environment, because a realm names an
# operator's users, clients and identity providers rather than anything about
# Proxy Smart. Deployments add it with a one-line overlay:
#
#   ARG BASE_IMAGE
#   FROM ${BASE_IMAGE}
#   COPY realm-export.json /opt/keycloak/data/import/realm-export.json
#
# Baking a default here is what made an earlier version dangerous: the fallback
# was the dev fixture realm, whose passwords and admin-service secret are
# published in this repository, and a production build that omitted the env
# overlay silently imported it. Starting with no realm fails visibly instead.
#
# Local development does not use this image at all — docker-compose.yml and
# docker-compose.development.yml run the stock Keycloak image and bind-mount
# keycloak/realm-export.json.

# Copy custom login theme (IdP button icons, branding overrides)
COPY keycloak/themes/proxy-smart /opt/keycloak/themes/proxy-smart

# Set environment variables for production operation
ENV KEYCLOAK_ADMIN=admin
ENV KC_DB=postgres
ENV KC_PROXY_HEADERS=xforwarded
ENV KC_HTTP_ENABLED=true
ENV KC_HOSTNAME_STRICT=false
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true

# Limit JVM heap at runtime (prevents OOM on small VPS instances)
ENV JAVA_OPTS_KC_HEAP="-Xms128m -Xmx512m"

# Build Keycloak to optimize startup time
# JAVA_TOOL_OPTIONS is read by the JVM itself, ensuring kc.sh build respects the heap limit
#
# --features ADDS to Keycloak's default set, so only non-default features are listed.
# cimd and resource-indicators are still EXPERIMENTAL in 26.8.1 (Profile.java);
# docs/keycloak-features.md has the full table.
#
# --http-relative-path must match the runtime KC_HTTP_RELATIVE_PATH, otherwise KC
# detects config drift and re-builds WITHOUT features, causing realm import crash.
#
# Per-environment, because the path is part of every URL Keycloak issues —
# including the OIDC issuer:
#   beta / dev  → /auth   Keycloak shares one domain with the proxy, so it needs
#                         a prefix to avoid colliding with the proxy's own routes.
#   production  → /       Keycloak has its own subdomain (auth.proxy-smart.com)
#                         and already serves at root. Baking /auth here would move
#                         the issuer to .../auth/realms/proxy-smart, invalidating
#                         every live token and breaking every client configured
#                         against the current issuer.
#
# Default stays /auth so beta and dev builds are unchanged; production overrides it.
ARG KC_RELATIVE_PATH=/auth
RUN JAVA_TOOL_OPTIONS="-Xmx512m" /opt/keycloak/bin/kc.sh build \
    --features=cimd,resource-indicators \
    --http-relative-path=${KC_RELATIVE_PATH}

# Start Keycloak in production mode with realm import and optimized settings.
# --optimized tells KC to use the pre-built config from `kc.sh build` above,
# preventing a re-build that would strip the --features flag.
#
# ENTRYPOINT is the binary ONLY; the arguments live in CMD. That split matters:
# Docker APPENDS CMD to an exec-form ENTRYPOINT, and ECS task definitions set
# `command`, which replaces CMD. With the arguments baked into ENTRYPOINT, an
# ECS `command: ["start","--optimized"]` produced
#     kc.sh start --optimized --import-realm start --optimized
# which Keycloak rejects. Keeping args in CMD lets any runtime override them
# cleanly, and callers that override MUST pass --import-realm themselves (the
# ECS task definition in the proxy-smart-infra repo does).
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]
