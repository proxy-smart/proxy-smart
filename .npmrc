# Variable references ONLY — never paste a token here.
#
# bunfig.toml's [install.scopes] authenticates the registry metadata endpoint but
# not GitHub's /download/<scope>/<name>/<version>/<sha> tarball path, which 401s.
# A host-wide _authToken covers both. Same pattern as Max-Health-Inc/fhir-igs.
@proxy-smart:registry=https://npm.pkg.github.com
@max-health-inc:registry=https://npm.pkg.github.com
@quotentiroler:registry=https://npm.pkg.github.com
@babelfhir-ts:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GH_PACKAGES_TOKEN}
