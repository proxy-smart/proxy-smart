{
  "name": "proxy-smart-backend",
  "displayName": "Proxy Smart Backend",
  "version": "0.4.13-alpha.202609091108.a43fecf7f",
  "type": "module",
  "scripts": {
    "test": "bun test --isolate",
    "test:watch": "bun test --isolate --watch",
    "dev": "bun run --watch --watch-path src src/index.ts",
    "start": "bun run src/index.ts",
    "mcp": "bun run src/mcp-server.ts",
    "build": "tsc --noEmit && bun build src/index.ts --outdir dist --target node --external undici --external node-fetch",
    "export-openapi": "mkdir -p dist && bun run src/export-openapi.ts && bun run scripts/sanitize-openapi.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.51",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.15",
    "@elysiajs/static": "^1.4.10",
    "@keycloak/keycloak-admin-client": "26.6.4",
    "@proxy-smart/consent-fhir": "^0.1.0",
    "@proxy-smart/elysia-mcp": "workspace:*",
    "@maxhealth.tech/mcp-http": "^0.5.0",
    "@maxhealth.tech/prefab": "^0.3.13",
    "@modelcontextprotocol/server": "^2.0.0",
    "@proxy-smart/app-store": "workspace:*",
    "@proxy-smart/auth": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "ai": "^7.0.84",
    "cross-fetch": "^4.1.0",
    "date-fns": "^4.4.0",
    "elysia": "^1.4.30",
    "@max-health-inc/fhir-ips": "^2.0.15",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "kill-the-clipboard": "^1.1.0",
    "node-fetch": "^3.3.2",
    "node-forge": "^1.4.0",
    "pg": "^8.23.0",
    "resend": "^6.25.0",
    "unifi-access": "^1.5.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@types/bun": "^1.4.0",
    "@types/fhir": "^0.0.44",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-fetch": "^2.6.13",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "module": "src/index.js"
}
