{
  "name": "proxy-smart-backend",
  "displayName": "Proxy Smart Backend",
  "version": "0.7.8-alpha.202610222106.00c4904e1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --isolate",
    "test:watch": "bun test --isolate --watch",
    "dev": "bun run --watch --watch-path src src/index.ts",
    "start": "bun run src/index.ts",
    "mcp": "bun run src/mcp-server.ts",
    "build": "bun run typecheck && bun build src/index.ts --outdir dist --target node --external undici --external node-fetch",
    "export-openapi": "mkdir -p dist && bun run src/export-openapi.ts && bun run scripts/sanitize-openapi.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.openapi.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.93",
    "@elysia/cors": "^1.4.2",
    "@elysia/openapi": "^1.4.16",
    "@elysia/static": "^1.4.11",
    "@keycloak/keycloak-admin-client": "26.8.1",
    "@max-health-inc/fhir-smart": "^2.2.20",
    "@maxhealth.tech/elysia-mcp": "^1.1.0",
    "@maxhealth.tech/mcp-http": "^0.7.0",
    "@maxhealth.tech/prefab": "^0.3.14",
    "@modelcontextprotocol/server": "^2.3.1",
    "@proxy-smart/app-store": "workspace:*",
    "@proxy-smart/auth": "workspace:*",
    "@proxy-smart/consent-fhir": "^0.2.0",
    "@proxy-smart/site-kit": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "ai": "^7.0.140",
    "brandc": "^0.8.0",
    "date-fns": "^4.4.0",
    "elysia": "^1.4.30",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "kill-the-clipboard": "^1.1.0",
    "node-fetch": "^3.3.2",
    "node-forge": "^1.4.0",
    "pg": "^8.23.1",
    "resend": "^6.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/bun": "~1.4.3",
    "@types/fhir": "^0.0.44",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-fetch": "^2.6.13",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "module": "src/index.js"
}
